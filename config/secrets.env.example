# QuantStudio 凭证环境变量模板（数据源唯一化终态 2026-08-28）
# 复制为 secrets.env 并填入真实凭证。secrets.env 不要提交到 git。
#
# 数据源唯一化：全项目唯一权威源 = MCP（其他源 tushare/baostock/akshare/xtquant/
# joinquant/custom_api 已全部停用并从配置/工厂/GUI 移除，凭据项随之废止）。

# MCP 权威源 API Key（唯一必填——缺失采集 fail-fast）
MCP_API_KEY=your_mcp_api_key_here

# 告警 webhook（可选，与数据源无关）
ALERT_WEBHOOK=
