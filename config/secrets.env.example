# QuantStudio 凭证环境变量模板
# 复制为 secrets.env 并填入真实凭证。secrets.env 不要提交到 git。

# Tushare Pro（付费，标准源）
TUSHARE_TOKEN=your_tushare_token_here

# 聚宽（可选）
JQ_TOKEN=your_joinquant_token_here

# miniQMT 路径（可选，有 QMT 账户时）
QMT_PATH=D:/国金QMT/userdata_mini

# 自定义 API（可选）
CUSTOM_API_KEY=your_custom_api_key_here

# 告警 webhook（可选）
ALERT_WEBHOOK=
