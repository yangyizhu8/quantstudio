  "qfq_maintenance": {
    "enabled": true,
    "rebuild_on_gap": true
  },
  "qfq_orchestrator": {
    "enabled": true,
    "require_bootstrap": true,
    "price_source": "mcp",
    "stock_factor_detector": "mcp_factor_detector",
    "etf_factor_detector": "mcp_factor_detector",
    "freqs": [
      "1min"
    ],
    "factor_overlap_lookback_days": 30,
    "fresh_fetch_workers": 4,
    "claim_lease_sec": 600,
    "retry_max": 5,
    "retry_backoff_sec": [
      60,
      120,
      240,
      480,
      960
    ],
    "watermark_policy": "hold_until_consistent",
