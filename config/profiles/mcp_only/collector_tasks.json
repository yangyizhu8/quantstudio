      "freq": "daily",
      "start_date": "2018-01-01",
      "codes": [
        "ALL"
      ],
      "max_workers": 8,
      "retry": {
        "max": 5,
        "backoff_sec": [
          60,
          120,
          240,
          480,
          960
        ]
      },
      "rate_limit": {
        "calls_per_min": 60,
        "wait_on_429": true
      },
      "source_priority": [
        "mcp"
      ]
    },
    {
      "name": "etf_kline_1m",
      "enabled": true,
      "source": "mcp",
      "table": "etf_minutes",
      "freq": "1min",
      "codes": [
        "ALL"
      ],
      "max_workers": 4,
      "retry": {
        "max": 5,
        "backoff_sec": [
          60,
          120,
          240,
          480,
          960
        ]
      },
      "rate_limit": {
        "calls_per_min": 1,
        "wait_on_429": true
      },
      "source_priority": [
        "mcp"
      ]
    },
    {
      "name": "stock_dividend",
      "enabled": true,
      "source": "mcp",
      "table": "stock_dividend",
      "freq": "daily",
      "start_date": "2018-01-01",
      "codes": [
        "ALL"
      ],
      "max_workers": 4,
      "retry": {
        "max": 5,
        "backoff_sec": [
          60,
          120,
          240,
          480,
          960
        ]
      },
      "rate_limit": {
        "calls_per_min": 30,
        "wait_on_429": true
