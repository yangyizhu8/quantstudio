{
  "_note": "mcp_only 独立任务配置：全部表 source=mcp 单源，QFQ 闭环 price_source/fresh_source 放开到 mcp。不改默认 config/collector_tasks.json。",
  "daemon_schedule": {
    "daily_time": "21:00",
    "check_interval_sec": 300
  },
  "tasks": [
    {
      "name": "kline_1d",
      "enabled": true,
      "source": "mcp",
      "table": "stock_daily",
      "freq": "daily",
      "start_date": "2018-01-01",
      "codes": [
        "ALL"
      ],
      "max_workers": 8,
      "retry": {
        "max": 5,
        "backoff_sec": [
          60,
          120,
          240,
          480,
          960
        ]
      },
      "rate_limit": {
        "calls_per_min": 60,
        "wait_on_429": true
      },
      "source_priority": [
        "mcp"
      ],
      "_note": "mcp_only：MCP 单源，含 adj_factor 原样返回（复权交给 aligner/P2-4）。"
    },
    {
      "name": "kline_1m",
      "enabled": true,
      "source": "mcp",
      "table": "stock_minutes",
      "freq": "1min",
      "codes": [
        "ALL"
      ],
      "max_workers": 4,
      "retry": {
        "max": 5,
        "backoff_sec": [
          60,
          120,
          240,
          480,
          960
        ]
      },
      "rate_limit": {
        "calls_per_min": 1,
        "wait_on_429": true
      },
      "source_priority": [
        "mcp"
      ],
      "_note": "mcp_only：MCP 分钟线单源，含 adj_factor 原样返回。"
    },
    {
      "name": "etf_kline_1d",
      "enabled": true,
