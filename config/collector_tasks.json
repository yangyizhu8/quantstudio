      "table": "stock_daily_valuation",
      "freq": "daily",
      "start_date": "2018-01-01",
      "codes": [
        "ALL"
      ],
      "max_workers": 4,
      "retry": {
        "max": 5,
        "backoff_sec": [
          60,
          120,
          240,
          480,
          960
        ]
      },
      "rate_limit": {
        "calls_per_min": 30,
        "wait_on_429": true
      },
      "hidden": true,
      "_note": "stock_daily 的依赖表，用户不可见。stock_daily 采集时自动先拉取。源改为 tushare 优先（daily_basic 提供真实每日 circ_mv/total_mv，已验证稳定落库）；akshare 作回退",
      "source_priority": [
        "tushare",
        "akshare"
      ]
    },
