 _IDENTIFIER_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
 
 
+def _minute_bars_per_day(storage_freq) -> int:
+    """分钟表「每交易日根数」估计（R-PERF-05/E-04 v3，仅决定快路径下界宽度）。
+
+    per_day = 240 / freq分钟数（1min⇒240 / 5min⇒48 / 15min⇒16 / 30min⇒8 / 60min⇒4）。
+    freq 无法解析时取**最稀疏 30min（8）**保守值 —— 下界更宽只降低命中率，
+    **不影响结果**：不足 count 根的码由慢路径无下界回退兜底（V-1/V-2/V-3）。
+    """
+    s = str(storage_freq or "").strip().lower()
+    m = re.match(r"^(\d+)\s*m(?:in)?$", s)
+    if m:
+        try:
+            n = int(m.group(1))
+            if n > 0:
+                return max(1, 240 // n)
+        except Exception:
+            pass
+    return 8
+
