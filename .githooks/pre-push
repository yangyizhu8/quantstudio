#!/bin/sh
# 推送前闸门（C7 机器化）—— Git 的 pre-push hook
#
# 设计见 docs/prepush-gate-design.md；核心判据在 scripts/prepush-gate.ps1。
#
# 触发：`git push` 时由 Git 自动执行，待推 ref 经 stdin 传入，格式为：
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
# **非零退出即中止推送** —— 这是「机器拦人」真正的技术落点。
#
# 语义（2026-10-20 方案 a 修复）：
#   - 窗口 = 实际推送范围 <remote-sha>..<local-sha>（支持 sha 形态 refspec：git push <sha>:main）；
#   - 范围内全部提交须被 -Commit 锚或 -AllowAlso 声明覆盖，任一未声明即 exit 9；
#   - 删除推送（local-sha 全零）不涉及提交，跳过；
#   - 本 hook 不自动读取任何裁定 ⇒ 例外永远是有意识的动作（不留后门）。
#   - 放行事实由 gate 侧强制写入 docs/handoff/push-bundle-rulings.log。
#
# 已知可绕过面（诚实披露，不声称绝对安全）：
#   `git push --no-verify` 可跳过本 hook —— 技术上无法阻止。
#   对策：C7 人工三查照旧执行（本门是叠加非替代）；留痕缺失可被事后审计发现；
#        纪律要求任何 --no-verify 推送须在回报中声明。

ROOT=$(git rev-parse --show-toplevel)
COMMIT=""
LOCAL_SHA=""
REMOTE_SHA=""

# ── 铁律预算门（2026-10-26 补挂 · 修复「AGENTS v2 声称已挂、实态零引用」）──────────
# 定位：**内容级检查，与推送范围无关** ⇒ 先于 stdin 分支解析执行，对一切 remote/分支生效
#       （含非 main 分支、sha 形态 refspec、多 push URL 双仓）。C7 闸的既有语义不动。
# 判据：scripts/check-iron-rules-budget.py 四查（预算/覆盖/指针/反向指针），exit 0 才放行。
# 姿态：**fail-closed**（与下方「未找到 pwsh 即 exit 9」同纪律）——门禁找不到执行器不得静默跳过；
#       如需绕过只能显式 `git push --no-verify`（与 C7 闸同一披露要求）。
if command -v python >/dev/null 2>&1; then
    PY=python
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
elif command -v py >/dev/null 2>&1; then
    PY=py
else
    PY=""
fi

if [ -z "$PY" ]; then
    echo "[iron-rules-budget] 未找到 python/python3/py —— 无法执行铁律预算门。" >&2
    echo "[iron-rules-budget] 按纪律拒绝推送；如确认无风险须显式 git push --no-verify（并在回报中声明）。" >&2
    exit 9
fi

if [ ! -f "$ROOT/scripts/check-iron-rules-budget.py" ]; then
    echo "[iron-rules-budget] 缺 scripts/check-iron-rules-budget.py —— 门禁不可用，拒绝推送。" >&2
    echo "[iron-rules-budget] 恢复脚本后重试；如确认无风险须显式 git push --no-verify（并在回报中声明）。" >&2
    exit 9
fi

"$PY" "$ROOT/scripts/check-iron-rules-budget.py"
BUDGET_RC=$?
if [ $BUDGET_RC -ne 0 ]; then
    echo "[iron-rules-budget] 四查未全绿（rc=$BUDGET_RC）⇒ 中止推送。" >&2
    echo "[iron-rules-budget] 修复预算/口径（见上方明细）后重试；如确认无风险须显式 git push --no-verify（并在回报中声明）。" >&2
    exit 9
fi

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main)
            # 删除推送（local_sha 全零）不涉及提交，跳过
            case "$local_sha" in
                0000000000000000000000000000000000000000) ;;
                *)
                    # 注意：sha 形态 refspec（git push <sha>:main）下 local_ref 可能就是 sha 本身，
                    # 一律以 stdin 的 local_sha / remote_sha 为准（不依赖 ref 名）。
                    COMMIT="$local_sha"
                    LOCAL_SHA="$local_sha"
                    REMOTE_SHA="$remote_sha"
                    ;;
            esac
            ;;
    esac
done

# 非 main 分支的推送不在本门管辖
if [ -z "$COMMIT" ]; then
    exit 0
fi

# ── 依赖闭包门（R66 方案 b · 2026-11-02 · fail-closed）────────────────────────
# 判据：本次待推范围（base..local-sha）内文件所引用的**一等方模块**（quantstudio/ tests/
#       scripts/ config/ 四个顶层）是否完整落在 <local-sha> 树内——
#       被引用模块若「工作区存在但未随本次推送入库」⇒ 远端必然 ImportError / CI 红 ⇒ 阻断。
# 范围：与 C7 闸同域（仅 main 推送）；仅解析待推集自身的 .py（精确限定推送者自己的文件）。
# base 取值：优先远端当前 sha（stdin 传入）；不可解析时回退 origin/main → eco/main 跟踪引用；
#             两者皆无 ⇒ 无范围可比 ⇒ 显式提示后放行（与 C7 闸同纪律，不伪装「清单为空」）。
# 豁免通道：scripts/dependency_closure_allowlist.json（精确/通配/目录前缀）或 QS_DEP_CLOSURE_ALLOW。
# 已知可绕过面：`git push --no-verify`（同 C7 闸披露要求，须在回报中声明）。
DEPCL_BASE=""
if [ "$REMOTE_SHA" != "0000000000000000000000000000000000000000" ] \
   && git rev-parse --verify --quiet "$REMOTE_SHA^{commit}" >/dev/null 2>&1; then
    DEPCL_BASE="$REMOTE_SHA"
else
    for _ref in refs/remotes/origin/main refs/remotes/eco/main; do
        if git rev-parse --verify --quiet "$_ref" >/dev/null 2>&1; then
            DEPCL_BASE="$_ref"
            break
        fi
    done
fi

if [ -z "$DEPCL_BASE" ]; then
    echo "[dep-closure] 无远端参照（远端 sha 不可解析且 origin/main、eco/main 均缺）⇒ 跳过（无范围可比）。" >&2
    echo "[dep-closure] 提示：若认为远端已存在该分支，请先 git fetch 后重试。" >&2
else
    if [ ! -f "$ROOT/scripts/check_dependency_closure.py" ]; then
        echo "[dep-closure] 缺 scripts/check_dependency_closure.py —— 门禁不可用，拒绝推送。" >&2
        echo "[dep-closure] 恢复脚本后重试；如确认无风险须显式 git push --no-verify（并在回报中声明）。" >&2
        exit 9
    fi
    if [ -n "$QS_DEP_CLOSURE_ALLOW" ]; then
        "$PY" "$ROOT/scripts/check_dependency_closure.py" \
            --base "$DEPCL_BASE" --head "$LOCAL_SHA" --allow "$QS_DEP_CLOSURE_ALLOW"
    else
        "$PY" "$ROOT/scripts/check_dependency_closure.py" --base "$DEPCL_BASE" --head "$LOCAL_SHA"
    fi
    DEPCL_RC=$?
    if [ $DEPCL_RC -ne 0 ]; then
        echo "[dep-closure] 依赖闭包未闭合（rc=$DEPCL_RC）⇒ 中止推送。" >&2
        echo "[dep-closure] 修复：把被引用的模块一并提交入库；确需豁免走 scripts/dependency_closure_allowlist.json 或 QS_DEP_CLOSURE_ALLOW。" >&2
        exit 9
    fi
fi

if command -v pwsh >/dev/null 2>&1; then
    PS=pwsh
elif command -v powershell >/dev/null 2>&1; then
    PS=powershell
else
    echo "[prepush-gate] 未找到 pwsh/powershell —— 无法执行闸门。" >&2
    echo "[prepush-gate] 按纪律拒绝推送；如确认无风险须显式 git push --no-verify（并在回报中声明）。" >&2
    exit 9
fi

# 放行参数：**必须显式给出才传** —— hook 不自动读取任何裁定，保证「捆绑推送」永远是有意识的动作。
if [ -n "$QS_PUSH_BUNDLE_ALLOWALSO" ]; then
    "$PS" -NoProfile -ExecutionPolicy Bypass -File "$ROOT/scripts/prepush-gate.ps1" \
        -Commit "$COMMIT" -LocalSha "$LOCAL_SHA" -RemoteSha "$REMOTE_SHA" \
        -AllowAlso "$QS_PUSH_BUNDLE_ALLOWALSO"
else
    "$PS" -NoProfile -ExecutionPolicy Bypass -File "$ROOT/scripts/prepush-gate.ps1" \
        -Commit "$COMMIT" -LocalSha "$LOCAL_SHA" -RemoteSha "$REMOTE_SHA"
fi
exit $?
