# Database files are large (12GB) and distributed separately (压缩包发给客户).
# The data/ directory itself is tracked (contains .gitkeep + placement guide).
data/*.db
data/*.db-journal
data/*.db.wal
data/*.sqlite
data/*.sqlite3
*.db-journal
*.db.wal
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/
venv_quant_studio/
config/secrets.env
output/
*.log

# Local AI/editor state
.claude/
.codebuddy/
.omc/
.zcode/

# Local runtime artifacts
_runtime/
*.sqlite
*.sqlite3
*.duckdb

# daemon 运行时（v3 进程解耦：子进程状态/锁/PID/日志）
data/.daemon.lock
data/.collector_run.lock
data/daemon_status.json
data/daemon_run_state.json
data/daemon_stop.request
data/logs/

