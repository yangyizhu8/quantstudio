      {"id": "momentum_score", "operation": "multiply", "parameters": {"sources": ["regression_slope", "r_squared"]}},
      {"id": "eligible_pool", "operation": "and", "parameters": {"sources": ["trend_filter", "volume_surge"], "negate_sources": ["volume_surge"]}},
      {"id": "volume_exit", "operation": "held_exit", "parameters": {"trigger": "volume_surge", "execution_clock": "next_open"}},
      {"id": "top3", "operation": "top_n", "parameters": {"source": "momentum_score", "eligible_filter": "eligible_pool", "exit_signal": "volume_exit", "top_n": 3, "ascending": false}}
    ]
  },
  "portfolio": {
    "kind": "equal_weight_top_n",
    "parameters": {"max_positions": 3, "rebalance": "signal_triggered", "target_weight": 1.0}
  },
  "execution": {
