{% if security_code %}
import numpy as np


def initialize(context):
    # UniverseNode (kind=single_stock): single-instrument strategy.
    g.security = '{{ security_code }}'
    g.lookback = {{ dataload_lookback }}


def before_trading_start(context, data):
    # Selection/status preparation belongs here. Signal OHLC is loaded only
    # after the daily bar is complete so the whole series has one qfq basis.
    pass


def handle_data(context, data):
    # IndicatorNode(s): fetch history plus the completed current bar entirely
    # from front-adjusted columns. Never append raw BarDict OHLC.
    h = get_history(
        {{ dataload_lookback + 1 }}, '{{ dataload_frequency }}',
        field={{ dataload_fields }}, security_list=g.security,
        fq='pre', include=True, is_dict=True
    )
    frame = h[g.security]
    if frame is None or '{{ dataload_fields[0] }}' not in frame:
        return
    close_data = np.asarray(frame['{{ dataload_fields[0] }}'].values, dtype=float)
    if len(close_data) == 0 or not np.all(np.isfinite(close_data)):
        return
{% for ma in ma_indicators %}
    {{ ma.id }} = _get_ma(close_data, {{ ma.lookback }})
{% endfor %}

    # SignalNode (operation=cross, direction={{ signal_direction }}).
    # {{ ma_fast.id }} = fast ({{ ma_fast.lookback }}d), {{ ma_slow.id }} = slow ({{ ma_slow.lookback }}d).
    cash = context.portfolio.cash
    position = get_position(g.security)

    # Golden cross: fast > slow AND no position -> buy.
    if {{ ma_fast.id }} > {{ ma_slow.id }} and position.amount == 0:
        order_value(g.security, cash)
        log.info('Buying %s' % g.security)

    # Death cross: fast < slow AND position held -> sell.
    elif {{ ma_fast.id }} < {{ ma_slow.id }} and position.enable_amount > 0:
        order_target(g.security, 0)
        log.info('Selling %s' % g.security)


def _get_ma(close_array, num):
    """Simple moving average helper (mirrors 双均线策略.py)."""
    return round(close_array[-num:].mean(), 2)
{% elif universe_codes %}
import numpy as np


def initialize(context):
    # UniverseNode (kind=manual_list): multi-stock rotation strategy.
    g.stock_list = [{% for c in universe_codes %}'{{ c }}'{% if not loop.last %}, {% endif %}{% endfor %}]
    g.lookback = {{ dataload_lookback }}
    g.max_positions = {{ portfolio_max_positions }}
    g.top_n = {{ ranking_top_n if ranking_top_n else portfolio_max_positions }}


def before_trading_start(context, data):
    # Selection-stage HardFilterNode: filter ST/HALT/DELISTING.
    g.stock_list = filter_stock_by_status(
        g.stock_list, filter_type=['ST', 'HALT', 'DELISTING'], query_date=None
    )


def handle_data(context, data):
    # Fetch history plus the completed current daily bar on one qfq basis.
    # Raw BarDict OHLC remains execution-only and never enters signal series.
    h = get_history_batch(
        g.stock_list, {{ dataload_lookback + 1 }}, '{{ dataload_frequency }}',
        fields={{ dataload_fields }}, fq='pre', include=True
    )
    g.history = {_bare_code(code): np.asarray(df['{{ dataload_fields[0] }}'].values, dtype=object)
                 for code, df in h.items()}
    scores = {}
    for code in g.stock_list:
        series = _finite_series(g.history.get(_bare_code(code), []))
{% if signal_op == 'cross' %}
        if len(series) < {{ [ma_fast.lookback, ma_slow.lookback]|max }} or not np.all(np.isfinite(series[-{{ [ma_fast.lookback, ma_slow.lookback]|max }}:])):
            continue
        {{ ma_fast.id }} = _get_ma(series, {{ ma_fast.lookback }})
        {{ ma_slow.id }} = _get_ma(series, {{ ma_slow.lookback }})
        if {{ ma_fast.id }} is None or {{ ma_slow.id }} is None or not ({{ ma_fast.id }} > {{ ma_slow.id }}):
            continue
{% endif %}
{% for ind in [ranking_indicator] %}
        if len(series) < {{ ind.lookback }} + 1 or not np.all(np.isfinite(series[-{{ ind.lookback }}-1:])):
            continue
        denominator = series[-{{ ind.lookback }}-1]
        if not np.isfinite(denominator) or denominator == 0:
            continue
        score = (series[-1] - denominator) / denominator
        if np.isfinite(score):
            scores[code] = score
{% endfor %}
{% if not pct_change_indicators %}
        scores[code] = series[-1]
{% endif %}
    sorted_codes = sorted(scores.keys(), key=lambda c: scores[c], reverse={{ not ranking_ascending }})
    selected = sorted_codes[:g.top_n]
    selected_bare = {_bare_code(code) for code in selected}

    positions = context.portfolio.positions
    for actual_code in list(positions.keys()):
        if _bare_code(actual_code) not in selected_bare:
            order_target_value(actual_code, 0)
            log.info('Selling %s' % actual_code)
    total_value = _portfolio_total_value(context)
    target_value = total_value / float(g.max_positions) if g.max_positions > 0 else 0.0
    for code in selected:
        order_target_value(code, target_value)
        log.info('Targeting %s value for %s' % (target_value, code))


def _portfolio_total_value(context):
    portfolio = context.portfolio
    for name in ('total_value', 'portfolio_value', 'total_asset'):
        value = getattr(portfolio, name, None)
        if value is not None:
            try:
                value = float(value)
                if np.isfinite(value) and value > 0:
                    return value
            except (TypeError, ValueError):
                pass
    market_value = sum(
        float(getattr(position, 'market_value', 0) or 0)
        for position in portfolio.positions.values()
    )
    return float(portfolio.cash) + market_value


def _bare_code(code):
    return str(code).strip().upper().split('.')[0]


def _finite_float(value):
    try:
        result = float(value)
    except (TypeError, ValueError):
        return None
    return result if np.isfinite(result) else None


def _finite_series(values):
    return np.asarray([
        converted if converted is not None else np.nan
        for converted in (_finite_float(value) for value in np.asarray(values, dtype=object).reshape(-1))
    ], dtype=float)


def _get_ma(close_array, num):
    if len(close_array) < num:
        return None
    value = close_array[-num:].mean()
    return round(value, 2) if np.isfinite(value) else None
