def _qs_get_history(codes, count, fields, C):
    """E1 语义取数（不含当前交易日，锚定前一交易日 D-1）。

    依据：07-行情函数.md:96-106（get_market_data_ex 原型）+:118（period='1d' 日线）
    +:121（count 数据个数）+:122（dividend_type='front' 前复权，对齐本地 fq='pre'）
    +:163-165（返回 dict{code: DataFrame}，index=time_list）+:85（不建议在 init 中运行）。
    E1 实现：count+1 多取一根、剔除最后一根（当前交易日）bar——对齐本地
    get_history(include=False) 语义与 count>=2 取 [-2] 锚定惯例（AGENTS.md E1 铁律）。
    M5 待钉死：末根 bar 是否含当前未完成 bar（M1 风险清单 1，渲染层单点可改）。
    """
    data = C.get_market_data_ex(list(fields), list(codes), period='1d',
                                count=int(count) + 1, dividend_type='front')
    result = {}
    if not data:
        return result
    for code in codes:
        frame = data.get(code)
        if frame is None or len(frame) == 0:
            continue
        result[code] = frame.iloc[:-1]  # 剔除最后一根（当前交易日）bar
    return result


def _qs_order_target_value(code, value, C):
    """order_target_value 补差语义（差额下单，本地与 PTrade 同构）。

    依据：08-交易函数.md:25-30（passorder 11 参原型）+:80-90（参数表：第 5 位
    prType/第 6 位 price/第 7 位 volume，M1 1.1 勘误后基准）；05-枚举常量.md:42-44
    （opType 23 买入/24 卖出）+:135-137（orderType 1101 单股单账号股/手方式）
    +:196（prType 5 最新价；price 位填 0 为文档允许值，08:85）；08:88（quickTrade=1：
    非历史 bar 即触发，信号于下一根 K 线首 tick 成交语义）。
    持仓面：08:585-587/594-595/598（get_trade_detail_data + 'STOCK'/'POSITION'）
    +:645-649（m_nVolume 总量/m_nCanUseVolume 可用量，T+1 卖出按可用量封顶）。
    价格参考：C.get_market_data_ex(['close'], count=2) 末行不复权 close（07:122
    dividend_type='none'）——执行层价格参考，非信号输入（E1 边界外）。
    """
    held = 0
    available = 0
    for item in get_trade_detail_data(ACCOUNT, 'STOCK', 'POSITION') or []:
        if '%s.%s' % (item.m_strInstrumentID, item.m_strExchangeID) == code:
            held = int(getattr(item, 'm_nVolume', 0) or 0)
            available = int(getattr(item, 'm_nCanUseVolume', 0) or 0)
            break
    value = float(value)
    if value <= 0:
        if available > 0:
            passorder(24, 1101, ACCOUNT, code, 5, 0, available,
                      STRATEGY_ID, 1, '', C)
        return
    price_data = C.get_market_data_ex(['close'], [code], period='1d',
                                      count=2, dividend_type='none')
    frame = price_data.get(code) if price_data else None
    price = 0.0
    if frame is not None and len(frame) > 0:
        price = float(frame['close'].values[-1])
    if not np.isfinite(price) or price <= 0:
        print('[%s] %s latest price unavailable, skip rebalance' % (STRATEGY_ID, code))
        return
    lot = 100  # A 股与 ETF 整手（spec hard_filters.round_lot）
    target_volume = int(value / price / lot) * lot
    delta = target_volume - held
    if delta > 0:
        passorder(23, 1101, ACCOUNT, code, 5, 0, int(delta),
                  STRATEGY_ID, 1, '', C)
    elif delta < 0:
        sell_volume = min(-delta, available)
        if sell_volume > 0:
            passorder(24, 1101, ACCOUNT, code, 5, 0, int(sell_volume),
                      STRATEGY_ID, 1, '', C)


def _qs_get_positions(C):
    """持仓视图（code 到持仓量映射）。

    依据：08-交易函数.md:585-587（签名）+:594-595（'STOCK'/'POSITION' 枚举）
    +:598（返回 list）+:645-649（字段 m_strInstrumentID/m_strExchangeID/m_nVolume）；
    代码拼接先例 08:662（m_strInstrumentID + '.' + m_strExchangeID）。
    """
    positions = {}
    for item in get_trade_detail_data(ACCOUNT, 'STOCK', 'POSITION') or []:
        code = '%s.%s' % (item.m_strInstrumentID, item.m_strExchangeID)
        positions[code] = int(getattr(item, 'm_nVolume', 0) or 0)
    return positions


