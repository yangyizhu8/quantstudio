def handlebar(C):
    # 门控（预留点，M1 1.1(1)）：日线周期每根 bar 即一交易日 -> 恒执行；
    # 实盘 tick 驱动下的当日去重与 run_daily 时点判定为 M5 实盘增强域。
    if not _qs_should_run_daily(C):
        return
    codes = list(C.stock_list)
    history = _qs_get_history(codes, C.lookback, ['close'], C)

    scores = {}
    for code in codes:
        frame = history.get(code)
        if frame is None or len(frame) == 0:
            continue
        closes = np.asarray(frame['close'].values, dtype=float)
{% if signal_op == 'cross' %}
        required_ma = {{ [ma_fast.lookback, ma_slow.lookback]|max }}
        if len(closes) < required_ma or not np.all(np.isfinite(closes[-required_ma:])):
            continue
        {{ ma_fast.id }} = _qs_get_ma(closes, {{ ma_fast.lookback }})
        {{ ma_slow.id }} = _qs_get_ma(closes, {{ ma_slow.lookback }})
        if {{ ma_fast.id }} is None or {{ ma_slow.id }} is None or not ({{ ma_fast.id }} > {{ ma_slow.id }}):
            continue
{% endif %}
        required = int(C.rank_lookback) + 1
        if len(closes) < required or not np.all(np.isfinite(closes[-required:])):
            continue
        denominator = closes[-required]
        if denominator <= 0:
            continue
        score = (closes[-1] - denominator) / denominator
        if np.isfinite(score):
            scores[code] = float(score)

    sorted_codes = sorted(scores.keys(), key=lambda k: scores[k], reverse={{ not ranking_ascending }})
    selected = sorted_codes[:int(C.top_n)]
    selected_set = set(selected)

    # 调仓次序对齐本地与 PTrade 模板：先卖出（跌出 Top-N），后等权目标买入
    for pos_code in list(_qs_get_positions(C).keys()):
        if pos_code not in selected_set:
            _qs_order_target_value(pos_code, 0.0, C)
            print('[%s] Selling %s' % (STRATEGY_ID, pos_code))
    total_value = _qs_account_total_value(C)
    target_value = total_value / float(C.max_positions) if int(C.max_positions) > 0 else 0.0
    for code in selected:
        _qs_order_target_value(code, target_value, C)
        print('[%s] Targeting %s value for %s' % (STRATEGY_ID, target_value, code))


