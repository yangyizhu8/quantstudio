def _qs_account_total_value(C):
    """账号总资产（等权目标额度基准）。

    依据：08-交易函数.md:585-587（get_trade_detail_data）+:595（'ACCOUNT' 数据类型）
    +:652-656（ACCOUNT 字段 m_dBalance 总资产）。
    """
    for item in get_trade_detail_data(ACCOUNT, 'STOCK', 'ACCOUNT') or []:
        return float(getattr(item, 'm_dBalance', 0.0) or 0.0)
    return 0.0
{% if signal_op == 'cross' %}

def _qs_get_ma(close_array, num):
    if len(close_array) < num:
        return None
    value = close_array[-num:].mean()
    return round(value, 2) if np.isfinite(value) else None
