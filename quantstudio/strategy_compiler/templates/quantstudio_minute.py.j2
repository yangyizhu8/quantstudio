def before_trading_start(context, data):
    # DataLoadNode (minute): preload daily snapshot for limit checks.
    # Minute profile uses daily pctChg for immediate-execute limit validation
    # (ptrade_api.py attach_day); minute preClose is unadjusted.
    h = get_history({{ dataload_lookback }}, '1d',
                    field={{ dataload_fields }}, security_list=g.security,
                    fq='dypre', include=False, is_dict=True)
    g.close_data = h[g.security]['{{ dataload_fields[0] }}']


def _trade_on_minute(context):
    """Scheduled at 09:35 by run_daily (fires before handle_data on that bar).

    Uses minute-anchored get_history to avoid future-bar leakage.
    """
    # Minute history: include=False ensures no future minute leaks.
    h = get_history({{ dataload_lookback }}, '{{ bar_frequency }}',
                    field={{ dataload_fields }}, security_list=g.security,
                    fq='dypre', include=False, is_dict=True)
    close_data = h[g.security]['{{ dataload_fields[0] }}']
{% for ma in ma_indicators %}
    {{ ma.id }} = _get_ma(close_data, {{ ma.lookback }})
{% endfor %}

    cash = context.portfolio.cash
    position = get_position(g.security)

    if {{ ma_fast.id }} > {{ ma_slow.id }} and position.amount == 0:
        order_value(g.security, cash)
        log.info('Buying %s @ %s' % (g.security, context.current_dt))
    elif {{ ma_fast.id }} < {{ ma_slow.id }} and position.enable_amount > 0:
        order_target(g.security, 0)
        log.info('Selling %s @ %s' % (g.security, context.current_dt))


def handle_data(context, data):
