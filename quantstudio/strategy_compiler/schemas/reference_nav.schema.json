{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quantstudio.local/schemas/reference_nav.schema.json",
  "title": "CP3 Reference NAV Artifact",
  "type": "object",
  "required": ["schema_version", "strategy_id", "engine_semantics_version", "timezone", "currency", "generated_at", "nav_series"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "strategy_id": {"type": "string", "minLength": 1},
    "engine_semantics_version": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_digest_ref": {"type": "string", "minLength": 1},
    "nav_series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trading_date", "total_value", "cash"],
        "properties": {
          "trading_date": {"type": "string", "format": "date"},
          "total_value": {"type": "number"},
          "cash": {"type": "number"},
          "positions_value": {"type": "number"},
          "positions_count": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
