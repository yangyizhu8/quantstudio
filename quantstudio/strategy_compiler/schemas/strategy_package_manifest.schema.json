{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Strategy Package Manifest",
  "description": "Manifest for a G3-rendered strategy package (Spec→IR→dual Renderer→package). Records version, entry points, artifact digests, target platforms, and optional G2 reference-closure linkage.",
  "type": "object",
  "required": [
    "manifest_version",
    "package_version",
    "strategy_id",
    "strategy_name",
    "target_platforms",
    "engine_semantics_version",
    "entry_points",
    "artifact_digests",
    "render_timestamp"
  ],
  "properties": {
    "manifest_version": { "type": "string", "const": "1.0" },
    "package_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
    "strategy_id": { "type": "string", "minLength": 1 },
    "strategy_name": { "type": "string" },
    "target_platforms": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "engine_semantics_version": { "type": "string" },
    "entry_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["platform", "filename"],
        "properties": {
          "platform": { "type": "string" },
          "filename": { "type": "string" }
        }
      }
    },
    "artifact_digests": {
      "type": "object",
      "description": "sha256 (hex) of each packaged artifact filename",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "render_timestamp": {
      "description": "Fixed sentinel for deterministic builds (NOT wall-clock).",
      "type": ["string", "null"]
    },
    "g2_reference_closure": {
      "type": ["object", "null"],
      "description": "Optional linkage to G2 CP3 frozen reference artifacts. Uses logical artifact IDs + sha256 (no dev-machine absolute paths for portability). When present, all 4 frozen artifacts were verified to exist (fail-closed) and data_digest_status records the deferred boundary.",
      "properties": {
        "frozen_artifact_digests": {
          "type": "object",
          "description": "sha256 (hex) of each G2 frozen artifact, keyed by logical ID",
          "properties": {
            "reference_signals": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "reference_orders": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "reference_nav": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "source_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "required": ["reference_signals", "reference_orders", "reference_nav", "source_digest"]
        },
        "data_digest_status": { "type": "string", "enum": ["frozen", "blocked"] },
        "oracle_source_digest": { "type": ["string", "null"] }
      },
      "required": ["frozen_artifact_digests", "data_digest_status"]
    },
    "builder_version": { "type": "string" }
  },
  "additionalProperties": false
}
