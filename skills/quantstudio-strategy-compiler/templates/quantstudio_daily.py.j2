{% if security_code %}
import numpy as np


def initialize(context):
    # UniverseNode (kind=single_stock): single-instrument strategy.
    g.security = '{{ security_code }}'
    g.lookback = {{ dataload_lookback }}


def before_trading_start(context, data):
    # DataLoadNode (pit_anchor=previous_date, no lookahead).
    # Pull N days of history anchored at previous close; include=False keeps
    # the current bar out of the pre-open snapshot (no future leak).
    h = get_history({{ dataload_lookback }}, '{{ dataload_frequency }}',
                    field={{ dataload_fields }}, security_list=g.security,
                    fq='dypre', include=False, is_dict=True)
    g.close_data = h[g.security]['{{ dataload_fields[0] }}']


def handle_data(context, data):
    # IndicatorNode(s): compute MA over history + current bar.
    current_price = data[g.security].close
    close_data = np.concatenate((g.close_data, np.array([current_price])), axis=0)
{% for ma in ma_indicators %}
    {{ ma.id }} = _get_ma(close_data, {{ ma.lookback }})
{% endfor %}

    # SignalNode (operation=cross, direction={{ signal_direction }}).
    # {{ ma_fast.id }} = fast ({{ ma_fast.lookback }}d), {{ ma_slow.id }} = slow ({{ ma_slow.lookback }}d).
    cash = context.portfolio.cash
    position = get_position(g.security)

    # Golden cross: fast > slow AND no position -> buy.
    if {{ ma_fast.id }} > {{ ma_slow.id }} and position.amount == 0:
        order_value(g.security, cash)
        log.info('Buying %s' % g.security)

    # Death cross: fast < slow AND position held -> sell.
    elif {{ ma_fast.id }} < {{ ma_slow.id }} and position.enable_amount > 0:
        order_target(g.security, 0)
        log.info('Selling %s' % g.security)


def _get_ma(close_array, num):
    """Simple moving average helper (mirrors 双均线策略.py)."""
    return round(close_array[-num:].mean(), 2)
{% elif universe_codes %}
import numpy as np


def initialize(context):
    # UniverseNode (kind=manual_list): multi-stock rotation strategy.
    g.stock_list = [{% for c in universe_codes %}'{{ c }}'{% if not loop.last %}, {% endif %}{% endfor %}]
    g.lookback = {{ dataload_lookback }}
    g.max_positions = {{ portfolio_max_positions }}


def before_trading_start(context, data):
    # DataLoadNode: batch history for all stocks (QuantStudio optimization).
    # QS profile allows get_history_batch; PTrade profile must loop (see ptrade template).
    h = get_history_batch(g.stock_list, {{ dataload_lookback }}, '{{ dataload_frequency }}',
                          field={{ dataload_fields }}, fq='dypre', include=False)
    g.history = h  # dict: code -> array of close
    # Selection-stage HardFilterNode: filter ST/HALT/DELISTING.
    g.stock_list = filter_stock_by_status(
        g.stock_list, filter_type=['ST', 'HALT', 'DELISTING'], query_date=None
    )


def handle_data(context, data):
    # IndicatorNode(s): pct_change per stock + RankingNode: top_n select.
    scores = {}
{% for ind in pct_change_indicators %}
    for code in g.stock_list:
        hist = g.history[code]
        curr = data[code].close
        series = np.concatenate((hist, [curr]))
        {{ ind.id }}[code] = (series[-1] - series[-{{ ind.lookback }}-1]) / series[-{{ ind.lookback }}-1]
{% endfor %}
    # RankingNode (operation={{ ranking_op }}, top_n={{ ranking_top_n }}, ascending={{ ranking_ascending }}).
    sorted_codes = sorted(scores.keys(), key=lambda c: scores[c], reverse={{ not ranking_ascending }})
    selected = sorted_codes[:g.max_positions]

    # PortfolioNode (kind=equal_weight_top_n): sell-first, buy-second.
    # Sell positions not in today's selected list.
    for code in list(context.portfolio.positions.keys()):
        if code not in selected:
            order_target_value(code, 0)
    # Buy missing selections with equal weight.
    position_count = len(context.portfolio.positions)
    if position_count < g.max_positions:
        value = context.portfolio.cash / (g.max_positions - position_count)
        for code in selected:
            if code not in context.portfolio.positions:
                order_value(code, value)
                log.info('Buying %s' % code)
