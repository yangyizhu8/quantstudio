def before_trading_start(context, data):
    # DataLoadNode: batch history for limit checks + scoring baseline.
    # get_history_batch returns CodeDict{code: DataFrame}; extract the close
    # column into a 1-D array per code. {{ dataload_frequency }} keeps the IR
    # frequency (daily snapshot even in minute profile — for limit checks).
    h = get_history_batch(g.stock_list, {{ dataload_lookback }}, '{{ dataload_frequency }}',
                          fields={{ dataload_fields }}, fq='dypre', include=False)
    g.history = {code: np.array(df['{{ dataload_fields[0] }}'].values, dtype=float)
                 for code, df in h.items()}
    g.stock_list = filter_stock_by_status(
        g.stock_list, filter_type=['ST', 'HALT', 'DELISTING'], query_date=None
    )


def _trade_on_minute(context):
    """Scheduled at 09:35 by run_daily. Minute-anchored, multi-stock rotation.

    Uses daily-history scores (preloaded in before_trading_start) for ranking;
    minute get_history is not pulled per-bar here (PR6b-1 keeps it simple —
    PR6b-2 may add per-bar minute scoring if a Spec declares minute indicators).
    """
    scores = {}
{% for ind in pct_change_indicators %}
    for code in g.stock_list:
        hist = g.history[code]
        scores[code] = (hist[-1] - hist[-{{ ind.lookback }}-1]) / hist[-{{ ind.lookback }}-1]
{% endfor %}
{% if not pct_change_indicators %}
    for code in g.stock_list:
        scores[code] = g.history[code][-1]
{% endif %}
    # RankingNode (operation={{ ranking_op }}, top_n={{ ranking_top_n }}, ascending={{ ranking_ascending }}).
    # Slice by ranking top_n (the IR-declared selection count), NOT max_positions.
    sorted_codes = sorted(scores.keys(), key=lambda c: scores[c], reverse={{ not ranking_ascending }})
    selected = sorted_codes[:g.top_n]

    # PortfolioNode (kind=equal_weight_top_n): sell-first, buy-second.
    for code in list(context.portfolio.positions.keys()):
        if code not in selected:
            order_target_value(code, 0)
    position_count = len(context.portfolio.positions)
    if position_count < g.max_positions:
        value = context.portfolio.cash / (g.max_positions - position_count)
        for code in selected:
            if code not in context.portfolio.positions:
                order_value(code, value)
                log.info('Buying %s @ %s' % (code, context.current_dt))


def handle_data(context, data):
    pass


def _get_ma(close_array, num):
    """Simple moving average helper."""
    return round(close_array[-num:].mean(), 2)
