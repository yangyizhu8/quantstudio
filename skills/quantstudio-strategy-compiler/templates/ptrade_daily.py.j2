{% if security_code %}
import numpy as np


def initialize(context):
    g.security = '{{ security_code }}'
    g.lookback = {{ dataload_lookback }}
    g.target_hold = False
    run_daily(context, rebalance, time='{{ ptrade_rebalance_time }}')


def before_trading_start(context, data):
    try:
        history = get_history(
            g.lookback, '{{ dataload_frequency }}',
            field={{ dataload_fields }}, security_list=g.security,
            fq='pre', include=False, is_dict=True
        )
        item = _lookup_history_item(history, g.security)
        closes = _finite_series(_extract_history_field(item, '{{ dataload_fields[0] }}'))
    except Exception as exc:
        log.info('Skipping %s: history request failed: %s' % (g.security, exc))
        g.target_hold = False
        return

    required = {{ [ma_fast.lookback, ma_slow.lookback]|max }}
    if len(closes) < required or not np.all(np.isfinite(closes[-required:])):
        log.info('Skipping %s: insufficient valid history' % g.security)
        g.target_hold = False
        return

    {{ ma_fast.id }} = _get_ma(closes, {{ ma_fast.lookback }})
    {{ ma_slow.id }} = _get_ma(closes, {{ ma_slow.lookback }})
    g.target_hold = (
        {{ ma_fast.id }} is not None and {{ ma_slow.id }} is not None
        and {{ ma_fast.id }} > {{ ma_slow.id }}
    )


def rebalance(context):
    position = get_position(g.security)
    if g.target_hold:
        try:
            order_target_value(g.security, _portfolio_total_value(context))
            log.info('Targeting full position in %s' % g.security)
        except Exception as exc:
            log.info('Buy/target order failed for %s: %s' % (g.security, exc))
    elif position.enable_amount > 0:
        try:
            order_target(g.security, 0)
            log.info('Selling %s' % g.security)
        except Exception as exc:
            log.info('Sell order failed for %s: %s' % (g.security, exc))


def handle_data(context, data):
    pass


def _portfolio_total_value(context):
    portfolio = context.portfolio
    for name in ('total_value', 'portfolio_value', 'total_asset'):
        value = getattr(portfolio, name, None)
        if value is not None:
            try:
                value = float(value)
                if np.isfinite(value) and value > 0:
                    return value
            except (TypeError, ValueError):
                pass
    market_value = sum(
        float(getattr(position, 'market_value', 0) or 0)
        for position in portfolio.positions.values()
    )
    return float(portfolio.cash) + market_value


def _lookup_history_item(history, code):
    if history is None:
        return None
    try:
        return history[code]
    except (KeyError, IndexError, TypeError, ValueError):
        pass
    target = _bare_code(code)
    try:
        keys = history.keys()
    except AttributeError:
        return None
    for key in keys:
        if _bare_code(key) == target:
            try:
                return history[key]
            except Exception:
                return None
    return None


def _extract_history_field(history_item, field):
    if history_item is None:
        return np.asarray([], dtype=object)
    try:
        values = history_item[field]
    except (KeyError, IndexError, TypeError, ValueError):
        return np.asarray([], dtype=object)
    if hasattr(values, 'values'):
        values = values.values
    return np.asarray(values, dtype=object)


def _bare_code(code):
    return str(code).strip().upper().split('.')[0]


def _finite_float(value):
    try:
        result = float(value)
    except (TypeError, ValueError):
        return None
    return result if np.isfinite(result) else None


def _finite_series(values):
    converted = []
    for value in np.asarray(values, dtype=object).reshape(-1):
        number = _finite_float(value)
        converted.append(number if number is not None else np.nan)
    return np.asarray(converted, dtype=float)


def _get_ma(close_array, num):
    if len(close_array) < num:
        return None
    value = close_array[-num:].mean()
    return round(value, 2) if np.isfinite(value) else None
{% elif universe_codes %}
import numpy as np


def initialize(context):
    g.stock_list = [{% for c in universe_codes %}'{{ c }}'{% if not loop.last %}, {% endif %}{% endfor %}]
    g.lookback = {{ dataload_lookback }}
    g.max_positions = {{ portfolio_max_positions }}
    g.top_n = {{ ranking_top_n if ranking_top_n else portfolio_max_positions }}
    g.selected = []
    run_daily(context, rebalance, time='{{ ptrade_rebalance_time }}')


def before_trading_start(context, data):
    scores = {}
    for code in g.stock_list:
        try:
            history = get_history(
                g.lookback, '{{ dataload_frequency }}',
                field={{ dataload_fields }}, security_list=code,
                fq='pre', include=False, is_dict=True
            )
            item = _lookup_history_item(history, code)
            closes = _finite_series(_extract_history_field(item, '{{ dataload_fields[0] }}'))
        except Exception as exc:
            log.info('Skipping %s: history request failed: %s' % (code, exc))
            continue

{% if signal_op == 'cross' %}
        required_ma = {{ [ma_fast.lookback, ma_slow.lookback]|max }}
        if len(closes) < required_ma or not np.all(np.isfinite(closes[-required_ma:])):
            log.info('Skipping %s: insufficient MA history' % code)
            continue
        {{ ma_fast.id }} = _get_ma(closes, {{ ma_fast.lookback }})
        {{ ma_slow.id }} = _get_ma(closes, {{ ma_slow.lookback }})
        if {{ ma_fast.id }} is None or {{ ma_slow.id }} is None or not ({{ ma_fast.id }} > {{ ma_slow.id }}):
            continue
{% endif %}
        required_return = {{ ranking_indicator.lookback }} + 1
        if len(closes) < required_return or not np.all(np.isfinite(closes[-required_return:])):
            log.info('Skipping %s: fewer than %s valid daily closes' % (code, required_return))
            continue
        denominator = closes[-required_return]
        if denominator == 0:
            log.info('Skipping %s: zero return denominator' % code)
            continue
        score = (closes[-1] - denominator) / denominator
        if np.isfinite(score):
            scores[code] = float(score)

    candidates = list(scores.keys())
    if candidates:
        try:
            candidates = filter_stock_by_status(
                candidates, filter_type=['ST', 'HALT', 'DELISTING'], query_date=None
            )
        except Exception as exc:
            log.info('Status filter unavailable; retaining history-valid candidates: %s' % exc)
    candidates = [code for code in candidates if code in scores]
    sorted_codes = sorted(candidates, key=lambda code: scores[code], reverse={{ not ranking_ascending }})
    g.selected = sorted_codes[:g.top_n]
    log.info('Selected stocks for {{ ptrade_rebalance_time }} rebalance: %s' % g.selected)


def rebalance(context):
    selected = list(g.selected)
    selected_bare = set(_bare_code(code) for code in selected)
    positions = context.portfolio.positions

    for actual_code in list(positions.keys()):
        if _bare_code(actual_code) not in selected_bare:
            try:
                order_target_value(actual_code, 0)
                log.info('Selling %s' % actual_code)
            except Exception as exc:
                log.info('Sell order failed for %s: %s' % (actual_code, exc))

    total_value = _portfolio_total_value(context)
    target_value = total_value / float(g.max_positions) if g.max_positions > 0 else 0.0
    for code in selected:
        try:
            order_target_value(code, target_value)
            log.info('Targeting %s value for %s' % (target_value, code))
        except Exception as exc:
            log.info('Target order failed for %s: %s' % (code, exc))


def handle_data(context, data):
