{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quantstudio.local/schemas/agent_strategy_design.schema.json",
  "title": "QuantStudio Agent-first Strategy Design Contract",
  "type": "object",
  "required": [
    "design_version",
    "strategy_id",
    "strategy_name",
    "asset_class",
    "targets",
    "engine_profile",
    "market_data_contract",
    "strategy_semantics",
    "timing",
    "components",
    "constraints",
    "approximations",
    "open_questions",
    "user_confirmations",
    "output"
  ],
  "properties": {
    "design_version": {
      "enum": [
        "2.0",
        "2.1",
        "2.2"
      ],
      "description": "2.0 is the legacy dual-target contract; 2.1 adds explicit target and ETF-universe routing; 2.2 adds machine-checkable portfolio/execution-funding/history-coverage/R5-invariant contracts and verbatim confirmation evidence. 2.1 artifacts must not be auto-migrated to 2.2 PASS."
    },
    "strategy_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "strategy_name": {
      "type": "string",
      "minLength": 1
    },
    "asset_class": {
      "enum": [
        "stock",
        "etf",
        "mixed",
        "convertible_bond",
        "custom"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "quantstudio",
          "ptrade"
        ]
      }
    },
    "engine_profile": {
      "type": "object",
      "required": [
        "profile_id",
        "bar_frequency",
        "match_price_mode"
      ],
      "properties": {
        "profile_id": {
          "enum": [
            "daily-bar-v1",
            "minute-bar-v1",
            "daily-open-close-proxy-v1"
          ]
        },
        "bar_frequency": {
          "enum": [
            "1d",
            "1m",
            "5m",
            "15m",
            "30m",
            "60m"
          ]
        },
        "match_price_mode": {
          "enum": [
            "close",
            "open",
            "next_open",
            "current_bar"
          ]
        },
        "rebalance_mode": {
          "enum": [
            "legacy",
            "callback_basket"
          ],
          "description": "Engine basket activation requires profile_id=daily-bar-v1 + match_price_mode=next_open + rebalance_mode=callback_basket. Mandatory when rebalance_funding_contract.implementation_mode=basket_atomic_sell_first."
        },
        "expected_engine_semantics_version": {
          "type": "string",
          "description": "R5 compares config.csv engine_semantics_version against this value (e.g. 0.4.0-next_open_basket proves the basket was actually active)."
        }
      },
      "additionalProperties": true
    },
    "market_data_contract": {
      "type": "object",
      "required": [
        "signal_price_adjustment",
        "execution_price_basis"
      ],
      "properties": {
        "signal_price_adjustment": {
          "const": "pre",
          "description": "All OHLC inputs used by indicators, ranking, entry/exit signals and risk thresholds must be front-adjusted via fq='pre'."
        },
        "execution_price_basis": {
          "const": "pre_adjusted_price",
          "description": "撮合、现金、成交、持仓估值、data[code].price 和 BarData OHLC 统一使用引擎前复权快照（*_front，缺失时回退原始价）。该口径与信号 fq=pre 构成前复权闭环；raw_trade_price 不再是 Agent-first 设计允许的执行契约。"
        }
      },
      "additionalProperties": false
    },
    "strategy_semantics": {
      "type": "object",
      "required": [
        "universe",
        "entry_rules",
        "exit_rules",
        "portfolio_rules",
        "risk_rules"
      ],
      "properties": {
        "universe": {
          "type": "string",
          "minLength": 1
        },
        "entry_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exit_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "portfolio_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "timing": {
      "type": "object",
      "required": [
        "signal_data_cutoff",
        "decision_events",
        "holding_semantics"
      ],
      "properties": {
        "signal_data_cutoff": {
          "type": "string",
          "minLength": 1
        },
        "holding_semantics": {
          "type": "string",
          "minLength": 1
        },
        "decision_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "lifecycle"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "lifecycle": {
                "enum": [
                  "before_trading_start",
                  "handle_data",
                  "run_daily",
                  "after_trading_end"
                ]
              },
              "time": {
                "type": "string",
                "pattern": "^(?:[01]?\\d|2[0-3]):[0-5]\\d$"
              },
              "purpose": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "components": {
      "type": "object",
      "required": [
        "lifecycle_hooks",
        "api_groups",
        "required_apis"
      ],
      "properties": {
        "lifecycle_hooks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "initialize",
              "before_trading_start",
              "handle_data",
              "after_trading_end"
            ]
          }
        },
        "api_groups": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "required_apis": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "implementation_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "required": [
        "hard_filters",
        "no_lookahead",
        "portable_source_required",
        "runtime_state_guard_required"
      ],
      "properties": {
        "hard_filters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "no_lookahead": {
          "const": true
        },
        "portable_source_required": {
          "type": "boolean"
        },
        "runtime_state_guard_required": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "approximations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "confirmed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "user_confirmations": {
      "type": "object",
      "required": [
        "strategy_semantics",
        "execution_approximations",
        "component_plan"
      ],
      "properties": {
        "strategy_semantics": {
          "type": "boolean"
        },
        "execution_approximations": {
          "type": "boolean"
        },
        "component_plan": {
          "type": "boolean"
        },
        "generation_target": {
          "type": "boolean"
        },
        "static_etf_whitelist": {
          "type": "boolean"
        },
        "backtest_validation_mode": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "overwrite"
      ],
      "properties": {
        "overwrite": {
          "type": "boolean"
        },
        "quantstudio_path": {
          "type": "string"
        },
        "ptrade_path": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "universe_contract": {
      "type": "object",
      "required": [
        "mode",
        "local_dynamic_api_allowed"
      ],
      "properties": {
        "mode": {
          "enum": [
            "portable_public_api",
            "static_whitelist",
            "dynamic_local"
          ]
        },
        "local_dynamic_api_allowed": {
          "type": "boolean"
        },
        "local_dynamic_api": {
          "enum": [
            "get_etf_list_local"
          ]
        },
        "static_etf_whitelist": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{6}\\.(SS|SZ)$"
          }
        },
        "etf_type": {
          "enum": [
            "equity",
            "bond",
            "money",
            "commodity",
            "gold",
            "qdii",
            "all"
          ]
        },
        "active_only": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "portfolio_contract": {
      "type": "object",
      "required": [
        "sizing_mode",
        "allocation_mode",
        "target_holdings",
        "gross_exposure_target",
        "cash_buffer_ratio",
        "per_position_target_weight",
        "max_single_weight",
        "allow_leverage"
      ],
      "properties": {
        "sizing_mode": {
          "enum": [
            "runtime_total_value",
            "fixed_notional"
          ],
          "description": "runtime_total_value derives per-position targets from the runtime portfolio value (required_initial_cash must be null); fixed_notional binds absolute required_initial_cash and fixed_target_value."
        },
        "required_initial_cash": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "fixed_target_value": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "allocation_mode": {
          "enum": [
            "equal_weight",
            "signal_weighted",
            "custom"
          ]
        },
        "allocation_denominator": {
          "enum": [
            "configured_target_count",
            "actual_selected_count"
          ]
        },
        "target_holdings": {
          "type": "integer",
          "minimum": 1
        },
        "gross_exposure_target": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cash_buffer_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "per_position_target_weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "max_single_weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "allow_leverage": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "rebalance_funding_contract": {
      "type": "object",
      "required": [
        "requires_same_cycle_sell_proceeds",
        "implementation_mode",
        "cash_only_for_new_buys"
      ],
      "properties": {
        "requires_same_cycle_sell_proceeds": {
          "type": "boolean"
        },
        "implementation_mode": {
          "enum": [
            "sell_then_buy_immediate",
            "basket_atomic_sell_first",
            "staged_two_phase",
            "cash_only_new_buys"
          ]
        },
        "cash_only_for_new_buys": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "history_coverage_contract": {
      "type": "object",
      "required": [
        "lookback_bars",
        "frequency",
        "history_required_before_first_decision",
        "backtest_start_does_not_truncate_provider_history",
        "minimum_candidates_with_full_history"
      ],
      "properties": {
        "lookback_bars": {
          "type": "integer",
          "minimum": 0,
          "description": "Indicator lookback length. It does NOT mean the backtest start date must be preceded by this many trading days inside the selected window; provider history before the window start remains available."
        },
        "frequency": {
          "enum": [
            "1d",
            "1m",
            "5m",
            "15m",
            "30m",
            "60m"
          ]
        },
        "history_required_before_first_decision": {
          "const": true
        },
        "backtest_start_does_not_truncate_provider_history": {
          "const": true
        },
        "minimum_candidates_with_full_history": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "r5_deployment_invariants": {
      "type": "object",
      "required": [
        "holding_count_mode",
        "target_holdings",
        "minimum_fill_ratio",
        "minimum_gross_exposure",
        "maximum_cash_ratio_after_rebalance",
        "maximum_insufficient_cash_rejections",
        "require_at_least_one_rebalance"
      ],
      "properties": {
        "holding_count_mode": {
          "enum": [
            "strict_target_when_candidates_available",
            "up_to_target_count",
            "signal_dependent"
          ]
        },
        "target_holdings": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_fill_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_gross_exposure": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximum_cash_ratio_after_rebalance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximum_insufficient_cash_rejections": {
          "type": "integer",
          "minimum": 0
        },
        "require_at_least_one_rebalance": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "confirmation_evidence": {
      "type": "object",
      "description": "Design 2.2 verbatim customer confirmation records. Bare booleans are not evidence; required keys and field-level checks are enforced by agent_skill_common.confirmation_evidence_errors.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "confirmed",
          "customer_text",
          "confirmed_at",
          "source"
        ],
        "properties": {
          "confirmed": {
            "const": true
          },
          "customer_text": {
            "type": "string",
            "minLength": 1
          },
          "confirmed_at": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "const": "customer_reply"
          }
        },
        "additionalProperties": true
      }
    },
    "validation_execution": {
      "type": "object",
      "required": [
        "mode",
        "require_hash_bound_evidence"
      ],
      "properties": {
        "mode": {
          "enum": [
            "agent_managed",
            "user_pyqt"
          ]
        },
        "require_hash_bound_evidence": {
          "const": true
        },
        "candidate_filename_suffix": {
          "const": "__candidate_quantstudio.py"
        },
        "user_selects_backtest_window": {
          "type": "boolean"
        },
        "formal_publish_requires_backtest_pass": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "backtest_window_contract": {
      "type": "object",
      "required": [
        "strategy_must_not_hardcode_backtest_dates",
        "agent_must_not_start_unconfirmed_backtest"
      ],
      "properties": {
        "pool_latest_listing_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "hard_earliest_start_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "lookback_trading_days": {
          "type": "integer",
          "minimum": 0
        },
        "required_close_bars": {
          "type": "integer",
          "minimum": 1
        },
        "recommended_start_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "recommended_end_date_as_of_local_data": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "actual_window_selected_by": {
          "enum": [
            "user_pyqt",
            "customer_confirmed_agent_run"
          ]
        },
        "strategy_must_not_hardcode_backtest_dates": {
          "const": true
        },
        "agent_must_not_start_unconfirmed_backtest": {
          "const": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "design_version": {
            "const": "2.0"
          }
        }
      },
      "then": {
        "properties": {
          "targets": {
            "allOf": [
              {
                "contains": {
                  "const": "quantstudio"
                }
              },
              {
                "contains": {
                  "const": "ptrade"
                }
              }
            ]
          },
          "constraints": {
            "properties": {
              "portable_source_required": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_version": {
            "enum": [
              "2.1",
              "2.2"
            ]
          }
        }
      },
      "then": {
        "required": [
          "universe_contract",
          "validation_execution",
          "backtest_window_contract"
        ],
        "properties": {
          "user_confirmations": {
            "required": [
              "generation_target",
              "backtest_validation_mode"
            ],
            "properties": {
              "generation_target": {
                "const": true
              },
              "backtest_validation_mode": {
                "const": true
              }
            }
          },
          "targets": {
            "contains": {
              "const": "quantstudio"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_version": {
            "enum": [
              "2.1",
              "2.2"
            ]
          },
          "targets": {
            "contains": {
              "const": "ptrade"
            }
          },
          "asset_class": {
            "const": "etf"
          }
        },
        "required": [
          "asset_class"
        ]
      },
      "then": {
        "properties": {
          "constraints": {
            "properties": {
              "portable_source_required": {
                "const": true
              }
            }
          },
          "universe_contract": {
            "required": [
              "static_etf_whitelist"
            ],
            "properties": {
              "mode": {
                "const": "static_whitelist"
              },
              "local_dynamic_api_allowed": {
                "const": false
              },
              "static_etf_whitelist": {
                "minItems": 1
              }
            }
          },
          "user_confirmations": {
            "required": [
              "static_etf_whitelist"
            ],
            "properties": {
              "static_etf_whitelist": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_version": {
            "enum": [
              "2.1",
              "2.2"
            ]
          },
          "targets": {
            "contains": {
              "const": "ptrade"
            }
          }
        }
      },
      "then": {
        "properties": {
          "constraints": {
            "properties": {
              "portable_source_required": {
                "const": true
              }
            }
          },
          "universe_contract": {
            "properties": {
              "local_dynamic_api_allowed": {
                "const": false
              },
              "mode": {
                "not": {
                  "const": "dynamic_local"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_version": {
            "enum": [
              "2.1",
              "2.2"
            ]
          },
          "targets": {
            "const": [
              "quantstudio"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "constraints": {
            "properties": {
              "portable_source_required": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_version": {
            "enum": [
              "2.1",
              "2.2"
            ]
          },
          "targets": {
            "const": [
              "quantstudio"
            ]
          },
          "asset_class": {
            "const": "etf"
          }
        },
        "required": [
          "asset_class"
        ]
      },
      "then": {
        "properties": {
          "constraints": {
            "properties": {
              "portable_source_required": {
                "const": false
              }
            }
          },
          "universe_contract": {
            "required": [
              "local_dynamic_api",
              "etf_type",
              "active_only"
            ],
            "properties": {
              "mode": {
                "const": "dynamic_local"
              },
              "local_dynamic_api_allowed": {
                "const": true
              },
              "local_dynamic_api": {
                "const": "get_etf_list_local"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_version": {
            "enum": [
              "2.1",
              "2.2"
            ]
          },
          "validation_execution": {
            "properties": {
              "mode": {
                "const": "user_pyqt"
              }
            },
            "required": [
              "mode"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "validation_execution": {
            "required": [
              "candidate_filename_suffix",
              "user_selects_backtest_window",
              "formal_publish_requires_backtest_pass"
            ],
            "properties": {
              "candidate_filename_suffix": {
                "const": "__candidate_quantstudio.py"
              },
              "user_selects_backtest_window": {
                "const": true
              },
              "formal_publish_requires_backtest_pass": {
                "const": true
              }
            }
          },
          "backtest_window_contract": {
            "required": [
              "actual_window_selected_by"
            ],
            "properties": {
              "actual_window_selected_by": {
                "const": "user_pyqt"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_version": {
            "enum": [
              "2.1",
              "2.2"
            ]
          },
          "validation_execution": {
            "properties": {
              "mode": {
                "const": "agent_managed"
