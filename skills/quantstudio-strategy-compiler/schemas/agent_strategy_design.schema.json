{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quantstudio.local/schemas/agent_strategy_design.schema.json",
  "title": "QuantStudio Agent-first Strategy Design Contract",
  "type": "object",
  "required": [
    "design_version",
    "strategy_id",
    "strategy_name",
    "asset_class",
    "targets",
    "engine_profile",
    "market_data_contract",
    "strategy_semantics",
    "timing",
    "components",
    "constraints",
    "approximations",
    "open_questions",
    "user_confirmations",
    "output"
  ],
  "properties": {
    "design_version": {
      "enum": [
        "2.0",
        "2.1"
      ],
      "description": "2.0 is the legacy dual-target contract; 2.1 adds explicit target and ETF-universe routing."
    },
    "strategy_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "strategy_name": {
      "type": "string",
      "minLength": 1
    },
    "asset_class": {
      "enum": [
        "stock",
        "etf",
        "mixed",
        "convertible_bond",
        "custom"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "quantstudio",
          "ptrade"
        ]
      }
    },
    "engine_profile": {
      "type": "object",
      "required": [
        "profile_id",
        "bar_frequency",
        "match_price_mode"
      ],
      "properties": {
        "profile_id": {
          "enum": [
            "daily-bar-v1",
            "minute-bar-v1",
            "daily-open-close-proxy-v1"
          ]
        },
        "bar_frequency": {
          "enum": [
            "1d",
            "1m",
            "5m",
            "15m",
            "30m",
            "60m"
          ]
        },
        "match_price_mode": {
          "enum": [
            "close",
            "open",
            "next_open",
            "current_bar"
          ]
        }
      },
      "additionalProperties": true
    },
    "market_data_contract": {
      "type": "object",
      "required": [
        "signal_price_adjustment",
        "execution_price_basis"
      ],
      "properties": {
        "signal_price_adjustment": {
          "const": "pre",
          "description": "All OHLC inputs used by indicators, ranking, entry/exit signals and risk thresholds must be front-adjusted via fq='pre'."
        },
        "execution_price_basis": {
          "enum": [
            "raw_trade_price",
            "pre_adjusted_price"
          ],
          "description": "撮合/现金/成交/持仓估值的价格口径。raw_trade_price=原始成交价（真实报价口径）；pre_adjusted_price=前复权价（2026-07-25 方案A：引擎撮合/估值链路与信号链路统一前复权，消除ETF拆分/分红除权缺口，分红等价于自动再投资）。两种口径均为合法引擎 Profile，策略设计必须与目标引擎实际口径一致。"
        }
      },
      "additionalProperties": false
    },
    "strategy_semantics": {
      "type": "object",
      "required": [
        "universe",
        "entry_rules",
        "exit_rules",
        "portfolio_rules",
        "risk_rules"
      ],
      "properties": {
        "universe": {
          "type": "string",
          "minLength": 1
        },
        "entry_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exit_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "portfolio_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "timing": {
      "type": "object",
      "required": [
        "signal_data_cutoff",
        "decision_events",
        "holding_semantics"
      ],
      "properties": {
        "signal_data_cutoff": {
          "type": "string",
          "minLength": 1
        },
        "holding_semantics": {
          "type": "string",
          "minLength": 1
        },
        "decision_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "lifecycle"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "lifecycle": {
                "enum": [
                  "before_trading_start",
                  "handle_data",
                  "run_daily",
                  "after_trading_end"
                ]
              },
              "time": {
                "type": "string",
                "pattern": "^(?:[01]?\\d|2[0-3]):[0-5]\\d$"
              },
              "purpose": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "components": {
      "type": "object",
      "required": [
        "lifecycle_hooks",
        "api_groups",
        "required_apis"
      ],
      "properties": {
        "lifecycle_hooks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "initialize",
              "before_trading_start",
              "handle_data",
              "after_trading_end"
            ]
          }
        },
        "api_groups": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "required_apis": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "implementation_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "required": [
        "hard_filters",
        "no_lookahead",
        "portable_source_required",
        "runtime_state_guard_required"
      ],
      "properties": {
        "hard_filters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "no_lookahead": {
          "const": true
        },
        "portable_source_required": {
          "type": "boolean"
        },
        "runtime_state_guard_required": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "approximations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "confirmed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "user_confirmations": {
      "type": "object",
      "required": [
        "strategy_semantics",
        "execution_approximations",
        "component_plan"
      ],
      "properties": {
        "strategy_semantics": {
          "type": "boolean"
        },
        "execution_approximations": {
          "type": "boolean"
        },
        "component_plan": {
          "type": "boolean"
        },
        "generation_target": {
          "type": "boolean"
        },
        "static_etf_whitelist": {
          "type": "boolean"
        },
        "backtest_validation_mode": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "overwrite"
      ],
      "properties": {
        "overwrite": {
          "type": "boolean"
        },
        "quantstudio_path": {
          "type": "string"
        },
        "ptrade_path": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "universe_contract": {
      "type": "object",
      "required": [
        "mode",
        "local_dynamic_api_allowed"
      ],
      "properties": {
        "mode": {
          "enum": [
            "portable_public_api",
            "static_whitelist",
            "dynamic_local"
          ]
        },
        "local_dynamic_api_allowed": {
          "type": "boolean"
        },
        "local_dynamic_api": {
          "enum": [
            "get_etf_list_local"
          ]
        },
        "static_etf_whitelist": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{6}\\.(SS|SZ)$"
          }
        },
        "etf_type": {
          "enum": [
            "equity",
            "bond",
            "money",
            "commodity",
            "gold",
            "qdii",
            "all"
          ]
        },
        "active_only": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "validation_execution": {
      "type": "object",
      "required": [
        "mode",
        "require_hash_bound_evidence"
      ],
      "properties": {
        "mode": {
          "enum": [
            "agent_managed",
            "user_pyqt"
          ]
        },
        "require_hash_bound_evidence": {
          "const": true
        },
        "candidate_filename_suffix": {
          "const": "__candidate_quantstudio.py"
        },
        "user_selects_backtest_window": {
          "type": "boolean"
        },
        "formal_publish_requires_backtest_pass": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "backtest_window_contract": {
      "type": "object",
      "required": [
        "strategy_must_not_hardcode_backtest_dates",
        "agent_must_not_start_unconfirmed_backtest"
      ],
      "properties": {
        "pool_latest_listing_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "hard_earliest_start_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "lookback_trading_days": {
          "type": "integer",
          "minimum": 0
        },
        "required_close_bars": {
          "type": "integer",
          "minimum": 1
        },
        "recommended_start_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "recommended_end_date_as_of_local_data": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "actual_window_selected_by": {
          "enum": [
            "user_pyqt",
            "customer_confirmed_agent_run"
          ]
        },
        "strategy_must_not_hardcode_backtest_dates": {
          "const": true
        },
        "agent_must_not_start_unconfirmed_backtest": {
          "const": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "design_version": {
            "const": "2.0"
          }
        }
      },
      "then": {
        "properties": {
          "targets": {
            "allOf": [
              {
                "contains": {
                  "const": "quantstudio"
                }
              },
              {
                "contains": {
                  "const": "ptrade"
                }
              }
            ]
          },
          "constraints": {
            "properties": {
              "portable_source_required": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_version": {
            "const": "2.1"
          }
        }
      },
      "then": {
        "required": [
          "universe_contract",
          "validation_execution",
          "backtest_window_contract"
        ],
        "properties": {
          "user_confirmations": {
            "required": [
              "generation_target",
              "backtest_validation_mode"
            ],
            "properties": {
              "generation_target": {
                "const": true
              },
              "backtest_validation_mode": {
                "const": true
              }
            }
          },
          "targets": {
            "contains": {
              "const": "quantstudio"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_version": {
            "const": "2.1"
          },
          "targets": {
            "contains": {
              "const": "ptrade"
            }
          },
          "asset_class": {
            "const": "etf"
          }
        },
        "required": [
          "asset_class"
        ]
      },
      "then": {
        "properties": {
          "constraints": {
            "properties": {
              "portable_source_required": {
                "const": true
              }
            }
          },
          "universe_contract": {
            "required": [
              "static_etf_whitelist"
            ],
            "properties": {
              "mode": {
                "const": "static_whitelist"
              },
              "local_dynamic_api_allowed": {
                "const": false
              },
              "static_etf_whitelist": {
                "minItems": 1
              }
            }
          },
          "user_confirmations": {
            "required": [
              "static_etf_whitelist"
            ],
            "properties": {
              "static_etf_whitelist": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_version": {
            "const": "2.1"
          },
          "targets": {
            "contains": {
              "const": "ptrade"
            }
          }
        }
      },
      "then": {
        "properties": {
          "constraints": {
            "properties": {
              "portable_source_required": {
                "const": true
              }
            }
          },
          "universe_contract": {
            "properties": {
              "local_dynamic_api_allowed": {
                "const": false
              },
              "mode": {
                "not": {
                  "const": "dynamic_local"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_version": {
            "const": "2.1"
          },
          "targets": {
            "const": [
              "quantstudio"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "constraints": {
            "properties": {
              "portable_source_required": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_version": {
            "const": "2.1"
          },
          "targets": {
            "const": [
              "quantstudio"
            ]
          },
          "asset_class": {
            "const": "etf"
          }
        },
        "required": [
          "asset_class"
        ]
      },
      "then": {
        "properties": {
          "constraints": {
            "properties": {
              "portable_source_required": {
                "const": false
              }
            }
          },
          "universe_contract": {
            "required": [
              "local_dynamic_api",
              "etf_type",
              "active_only"
            ],
            "properties": {
              "mode": {
                "const": "dynamic_local"
              },
              "local_dynamic_api_allowed": {
                "const": true
              },
              "local_dynamic_api": {
                "const": "get_etf_list_local"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_version": {
            "const": "2.1"
          },
          "validation_execution": {
            "properties": {
              "mode": {
                "const": "user_pyqt"
              }
            },
            "required": [
              "mode"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "validation_execution": {
            "required": [
              "candidate_filename_suffix",
              "user_selects_backtest_window",
              "formal_publish_requires_backtest_pass"
            ],
            "properties": {
              "candidate_filename_suffix": {
                "const": "__candidate_quantstudio.py"
              },
              "user_selects_backtest_window": {
                "const": true
              },
              "formal_publish_requires_backtest_pass": {
                "const": true
              }
            }
          },
          "backtest_window_contract": {
            "required": [
              "actual_window_selected_by"
            ],
            "properties": {
              "actual_window_selected_by": {
                "const": "user_pyqt"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_version": {
            "const": "2.1"
          },
          "validation_execution": {
            "properties": {
              "mode": {
                "const": "agent_managed"
              }
            },
            "required": [
              "mode"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "validation_execution": {
            "required": [
              "formal_publish_requires_backtest_pass"
            ],
            "properties": {
              "formal_publish_requires_backtest_pass": {
                "const": true
              }
            }
          },
          "backtest_window_contract": {
            "required": [
              "actual_window_selected_by"
            ],
            "properties": {
              "actual_window_selected_by": {
                "const": "customer_confirmed_agent_run"
              }
            }
          }
        }
      }
    }
  ]
}