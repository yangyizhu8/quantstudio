{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quantstudio.local/schemas/user_backtest_evidence.schema.json",
  "title": "QuantStudio User PyQt Backtest Evidence",
  "type": "object",
  "required": [
    "evidence_version",
    "strategy_id",
    "candidate_path",
    "candidate_sha256",
    "execution_owner",
    "run_status",
    "backtest_status",
    "completed",
    "exception_count",
    "fatal_error",
    "backtest_data_source",
    "backtest_db_path",
    "start_date",
    "end_date",
    "initial_cash",
    "engine_profile",
    "match_price_mode",
    "log_excerpt",
    "result_dir",
    "artifacts",
    "reproducibility_artifacts"
  ],
  "properties": {
    "evidence_version": {
      "const": "2.1",
      "description": "2.1 binds real run artifacts with SHA-256 AND requires the R5 reproducibility gate (G3.5): the same strategy must be run twice in independent processes; reproducibility_artifacts' config/daily_stats/trades SHA-256 must equal the main run's, otherwise R5 FAIL. Self-reported runtime_checks booleans are informational only. Evidence 1.0/2.0 submissions are rejected as EVIDENCE_INCOMPLETE."
    },
    "strategy_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "candidate_path": {
      "type": "string",
      "minLength": 1
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_owner": {
      "const": "user_pyqt"
    },
    "run_status": {
      "enum": [
        "COMPLETED",
        "FAILED"
      ]
    },
    "backtest_status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "completed": {
      "type": "boolean"
    },
    "exception_count": {
      "type": "integer",
      "minimum": 0
    },
    "fatal_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "backtest_data_source": {
      "const": "duckdb_provider"
    },
    "backtest_db_path": {
      "type": "string",
      "minLength": 1
    },
    "start_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "end_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "initial_cash": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "engine_profile": {
      "type": "string",
      "minLength": 1
    },
    "match_price_mode": {
      "type": "string",
      "minLength": 1
    },
    "runtime_checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "Informational user notes only; never authoritative for R5 PASS."
    },
    "log_excerpt": {
      "type": "string",
      "minLength": 1
    },
    "result_dir": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute path of the exported backtest result directory containing config.csv/daily_stats.csv/trades.csv and the run log."
    },
    "artifacts": {
      "type": "object",
      "required": [
        "config_csv",
        "daily_stats_csv",
        "trades_csv",
        "log_file"
      ],
      "properties": {
        "config_csv": {
          "$ref": "#/definitions/artifact"
        },
        "daily_stats_csv": {
          "$ref": "#/definitions/artifact"
        },
        "trades_csv": {
          "anyOf": [
            {
              "$ref": "#/definitions/artifact"
            },
            {
              "type": "null"
            }
          ],
          "description": "May be null only for holding_count_mode=signal_dependent no-trade runs with a clean completion log; strict-target strategies must bind a real trades.csv."
        },
        "log_file": {
          "$ref": "#/definitions/artifact"
        }
      },
      "additionalProperties": false
    },
    "reproducibility_artifacts": {
      "type": "object",
      "required": [
        "config_csv",
        "daily_stats_csv",
        "trades_csv"
      ],
      "properties": {
        "config_csv": {
          "$ref": "#/definitions/artifact"
        },
        "daily_stats_csv": {
          "$ref": "#/definitions/artifact"
        },
        "trades_csv": {
          "anyOf": [
            {
              "$ref": "#/definitions/artifact"
            },
            {
              "type": "null"
            }
          ],
          "description": "May be null only when the main run is a signal_dependent no-trade run."
        }
      },
      "additionalProperties": false,
      "description": "G3.5 R5 复现性门禁：同一策略产物在第二个独立进程重跑的 config/daily_stats/trades 三件套（hash 绑定）。与主运行三件套 SHA-256 逐位一致才 PASS；不一致即 R5 FAIL 并归因。log 因含时间戳不参与跨运行比对。"
    },
    "log_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "report_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_class": {
      "enum": [
        "strategy_logic",
        "framework_data_api",
        "ptrade_profile_validator",
        "evidence_incomplete",
        "source_drift",
        "capital_contract_mismatch",
        "deployment_invariant_failed",
        "execution_funding_failed",
        "artifact_missing",
        "artifact_hash_mismatch",
        "artifact_contract_mismatch",
        "reproducibility_evidence_missing",
        "reproducibility_mismatch"
      ]
    },
    "external_db_override_confirmed": {
      "type": "boolean"
    }
  },
  "definitions": {
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "backtest_status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "run_status": {
            "const": "COMPLETED"
          },
          "completed": {
            "const": true
          },
          "exception_count": {
            "const": 0
          },
          "fatal_error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "backtest_status": {
            "const": "FAIL"
          }
        }
      },
      "then": {
        "required": [
          "failure_class"
        ]
      }
    }
  ],
  "additionalProperties": false
}
